        "jsCode": "// 1. Используем let и const\nlet counter = 0;\nconst myArray = [\"Минск\", \"Гродно\", \"Брест\"];\nconst myObject = {\n  name: \"Ковалевская\",\n  group: \"ТВП\",\n  lab: 4\n};\n\n// 2. Используем цикл for\nfor (let i = 0; i < myArray.length; i++) {\n  counter++;\n  console.log(`Город ${i}: ${myArray[i]}`);\n}\n\n// 3. Используем if/else\nlet message = \"\";\nif (counter > 2) {\n  message = \"Много городов\";\n} else {\n  message = \"Мало городов\";\n}\n\n// 4. Возвращаем объект с полем payload\nreturn {\n  payload: {\n    count: counter,\n    cities: myArray,\n    info: myObject,\n    status: message\n  }\n};"
