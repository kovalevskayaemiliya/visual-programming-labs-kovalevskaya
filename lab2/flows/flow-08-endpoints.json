        "z": "c4ae1e9a50d696ec",
        "name": "function 2",
        "func": "const id = msg.req.params.id;\nconst limit = parseInt(msg.req.query.limit) || 10;\nif (isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = { status: \"error\", message: \"ID must be a number\", code: 400 };\n    return [null, msg];\n}\nif (parseInt(id) > 100) {\n    msg.statusCode = 404;\n    msg.payload = { status: \"error\", message: \"Item not found\", code: 404 };\n    return [null, msg];\n}\nmsg.payload = { status: \"success\", itemId: parseInt(id), limit: limit, items: [{ id: parseInt(id), name: \"Item \" + id }] };\nreturn [msg, null];",
